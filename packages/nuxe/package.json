  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/nuxe-layout": {
      "types": "./dist/components/nuxe-layout.d.ts",
      "default": "./dist/components/nuxe-layout.js"
    },
    "./setup": {
      "types": "./dist/nuxe-setup.d.ts",
      "default": "./dist/nuxe-setup.js"
    }
