{
  "name": "@dvlkit/nuxe",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./entry-server": {
      "types": "./dist/lib/entry-server.d.ts",
      "default": "./dist/lib/entry-server.js"
    },
    "./components/nuxe-layout": {
      "types": "./dist/lib/components/nuxe-layout.d.ts",
      "default": "./dist/lib/components/nuxe-layout.js"
    }
  },
  "bin": {
    "nuxe": "dist/bin/nuxe.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@hono/node-server": "2.0.5",
    "@unhead/vue": "3.1.4",
    "@vitejs/plugin-vue": "6.0.7",
    "c12": "4.0.0-beta.5",
    "citty": "0.2.2",
    "hono": "4.12.26",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "valibot": "1.4.1",
    "vite": "8.0.16",
    "vue": "3.5.38",
    "vue-router": "5.1.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.4.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
