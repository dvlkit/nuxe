{
  "name": "@dvlkit/nuxe",
  "version": "0.7.28",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/client-only": {
      "types": "./dist/components/client-only.d.ts",
      "default": "./dist/components/client-only.js"
    },
    "./components/nuxe-layout": {
      "types": "./dist/components/nuxe-layout.d.ts",
      "default": "./dist/components/nuxe-layout.js"
    },
    "./components/nuxe-root": {
      "types": "./dist/components/nuxe-root.d.ts",
      "default": "./dist/components/nuxe-root.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/handler": {
      "types": "./dist/server/handler.d.ts",
      "default": "./dist/server/handler.js"
    },
    "./server/nitro-log-request": {
      "types": "./dist/server/nitro-log-request.d.ts",
      "default": "./dist/server/nitro-log-request.js"
    },
    "./runtime/server/handler": {
      "types": "./dist/server/handler.d.ts",
      "default": "./dist/server/handler.js"
    },
    "./runtime/server-polyfill": {
      "types": "./dist/runtime/server-polyfill.d.ts",
      "default": "./dist/runtime/server-polyfill.js"
    },
    "./runtime/server-head": {
      "types": "./dist/runtime/server-head.d.ts",
      "default": "./dist/runtime/server-head.js"
    },
    "./setup": {
      "types": "./dist/nuxe-setup.d.ts",
      "default": "./dist/nuxe-setup.js"
    }
  },
  "bin": {
    "nuxe": "dist/bin/nuxe.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvlkit/nuxe.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@unhead/vue": "3.1.4",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/compiler-sfc": "3.5.38",
    "acorn": "8.17.0",
    "c12": "4.0.0-beta.5",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "devalue": "5.8.1",
    "h3": "2.0.1-rc.22",
    "listhen": "1.10.0",
    "magic-string": "0.30.21",
    "nitro": "3.0.260610-beta",
    "ofetch": "2.0.0-alpha.3",
    "unctx": "2.5.0",
    "unplugin": "3.0.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "valibot": "1.4.1",
    "vite": "8.0.16",
    "vite-node": "6.0.0",
    "vue": "3.5.38",
    "vue-bundle-renderer": "2.3.1",
    "vue-router": "5.1.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.4.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
