    "citty": "0.2.2",
    "listhen": "1.10.0",
    "magic-string": "0.30.21",
    "nitro": "3.0.260610-beta",
    "unplugin": "3.0.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "valibot": "1.4.1",
    "vite": "8.0.16",
    "vue": "3.5.38",
    "vue-router": "5.1.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.4.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@vitejs/plugin-vue": "6.0.7",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
