{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    ".vuxe/**/*.d.ts",
    ".vuxe/typed-router.d.ts",
    "app.vue",
    "pages/**/*.vue",
    "layouts/**/*.vue",
    "components/**/*.vue",
    "composables/**/*.ts",
    "vuxe.config.ts"
  ]
}
